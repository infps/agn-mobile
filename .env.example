# Copy to .env and fill in. Nothing here is a real credential.

# Leave EXPO_PUBLIC_NODE_ENV unset (or anything but "production") for local work:
# the app then talks to the portal on the machine running Metro, which is what
# you want when the portal is on localhost:3000. Set it to "production" to point
# the app at the deployed API instead.
EXPO_PUBLIC_NODE_ENV=development
EXPO_PUBLIC_API_URL=https://pigeon-pulse.vercel.app/api

EXPO_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
